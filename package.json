{
  "name": "quicklist",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:emulator": "cross-env VITE_USE_FIREBASE_EMULATORS=true firebase emulators:exec --project demo-quicklist --config firebase.emulator.json 'cross-env VITE_USE_FIREBASE_EMULATORS=true vite --host 127.0.0.1'", 
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:rules": "firebase emulators:exec --project demo-quicklist --config firebase.emulator.json 'vitest run src/services/firebase/firestore.rules.test.ts'",
    "emulators": "firebase emulators:start --project demo-quicklist --config firebase.emulator.json",
    "check:allowlist": "node scripts/check-allowlist.mjs",
    "deploy:pages": "npm run build"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.0",
    "@mui/icons-material": "^6.4.12",
    "@mui/material": "^6.4.12",
    "firebase": "^13.4.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.5"
  },
  "overrides": {
    "@grpc/grpc-js": "^1.14.7",
    "re2": "^1.27.1"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^6.0.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.2.0",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^6.3.0",
    "cross-env": "^7.0.3",
    "firebase-tools": "^15.36.0",
    "jsdom": "^26.0.0",
    "typescript": "~5.7.3",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  }
}
