// LOCAL EMULATOR ONLY. Intentionally permissive for signed-in test accounts.
// Production deployment MUST use firestore.rules, never this file.
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /lists/{listId} {
      allow read, write: if request.auth != null;
      match /items/{itemId} {
        allow read, write: if request.auth != null;
      }
    }
  }
}
